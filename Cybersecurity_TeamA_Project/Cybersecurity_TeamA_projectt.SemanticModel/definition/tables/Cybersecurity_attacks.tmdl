table Cybersecurity_attacks
	lineageTag: 7113f0d4-7338-43ef-bd05-59f8599ea541

	measure 'Total Incidents' =
			
			COUNTROWS('Cybersecurity_attacks')
		formatString: 0
		lineageTag: c25afb0a-7378-4025-a73b-0f79a350caa1

	measure 'Average Anomaly Score' =
			
			AVERAGE('Cybersecurity_attacks'[Anomaly Scores])
		lineageTag: ea7280ae-6aba-4c9c-b026-8d965011b4c5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Maximum Anomaly Score' =
			
			MAX('Cybersecurity_attacks'[Anomaly Scores])
		lineageTag: 727a10a5-df3e-4284-985f-211b771be878

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Unique Source IPs' =
			
			DISTINCTCOUNT('Cybersecurity_attacks'[Source IP Address])
		formatString: 0
		lineageTag: b157b6c9-c1bd-41d3-8949-b33cd43da7f2

	measure 'Unique Destination IPs' =
			
			DISTINCTCOUNT('Cybersecurity_attacks'[Destination IP Address])
		formatString: 0
		lineageTag: 46697bda-79ed-41f7-ad11-a01f7de0f3f5

	measure 'Total Attack Types' =
			
			DISTINCTCOUNT('Cybersecurity_attacks'[Attack Type])
		formatString: 0
		lineageTag: 405caed5-b1b4-41be-9e85-40f110b73685

	measure 'High Severity Incidents' =
			
			CALCULATE(
			    [Total Incidents],
			    'Cybersecurity_attacks'[Severity Level] = "High"
			)
		formatString: 0
		lineageTag: 48c87c24-7698-4943-86d2-5aaad5f06b86

	measure 'Medium Severity Incidents' =
			
			CALCULATE(
			    [Total Incidents],
			    'Cybersecurity_attacks'[Severity Level] = "Medium"
			)
		formatString: 0
		lineageTag: 40a78a46-253a-4b59-a667-514edb2c0200

	measure 'Low Severity Incidents' =
			
			CALCULATE(
			    [Total Incidents],
			    'Cybersecurity_attacks'[Severity Level] = "Low"
			)
		formatString: 0
		lineageTag: 4b56344b-e34e-4fdf-b5d1-987e64e40c1c

	measure 'High Severity Percentage' =
			
			DIVIDE(
			    [High Severity Incidents],
			    [Total Incidents],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 46660470-bbf7-493a-8c09-287f3f130132

